{
  "name": "zuha-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute zuha_db --file=./schema.sql --remote",
    "db:seed": "wrangler d1 execute zuha_db --file=./seed.sql --remote",
    "db:migrate:local": "wrangler d1 execute zuha_db --file=./schema.sql --local",
    "db:seed:local": "wrangler d1 execute zuha_db --file=./seed.sql --local"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.5.0",
    "wrangler": "^3.78.0"
  }
}
